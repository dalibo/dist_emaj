-- start_stop.sql : non regression tests for Distributed E-Maj distributed groups starts, groups stops and mark set
-- It mainly tests the distEmaj.pl client.
--
--
-- Prepare the test context
--
-- set sequence restart value
select public.handle_dist_emaj_sequences(2000);
 handle_dist_emaj_sequences 
----------------------------
 
(1 row)

--
-- Test the distEmaj.pl client
--
-- A few detected errors in options
--   illegal action
\! ${DIST_EMAJ_DIR}/client/distEmaj.pl -d regression -U postgres --action dummy
 Distributed E-Maj (version <devel>) - launching parallel actions
----------------------------------------------------------------
Error: The action 'dummy' is unknown (start|stop|set_mark expected) !
--   missing cluster
\! ${DIST_EMAJ_DIR}/client/distEmaj.pl -d regression -U postgres --action start
 Distributed E-Maj (version <devel>) - launching parallel actions
----------------------------------------------------------------
Error: A cluster name must be supplied with the --cluster option !
--   missing mark
\! ${DIST_EMAJ_DIR}/client/distEmaj.pl -d regression -U postgres --action start --cluster my_cluster
 Distributed E-Maj (version <devel>) - launching parallel actions
----------------------------------------------------------------
Error: A mark must be supplied with the --mark option !
--   unauthorized user
\! ${DIST_EMAJ_DIR}/client/distEmaj.pl -d regression -U _regress_dist_emaj_anonym -W anonym --action start --cluster my_cluster --mark START
 Distributed E-Maj (version <devel>) - launching parallel actions
----------------------------------------------------------------
Error: the user is not allowed to access the dist_emaj database.
--
-- Start and stop tests
--
-- Errors on a server
--   missing groups (simulated from dist_emaj)
insert into dist_emaj.dist_emaj_cluster_group values
  ('my_cluster', 'emaj_1', 'extraGroup_1'),
  ('my_cluster', 'emaj_1', 'extraGroup_2');
\! ${DIST_EMAJ_DIR}/client/distEmaj.pl -d regression -U postgres --action start --cluster my_cluster --mark 'START'
 Distributed E-Maj (version <devel>) - launching parallel actions
----------------------------------------------------------------
Error while checking the cluster.
ERROR:  _verify_server (7): Error on server "emaj_1", some table groups (extraGroup_1, extraGroup_2) are missing.
CONTEXT:  PL/pgSQL function dist_emaj._verify_server(text,text,text,text,boolean) line 153 at RAISE
SQL statement "SELECT dist_emaj._verify_server(srv_name, srv_connect_string, groups_list, v_dblinkSchema, TRUE)
      FROM (
        SELECT srv_name, srv_connect_string,
               string_agg(quote_literal(clgrp_group), ',' ORDER BY clgrp_group) AS groups_list
          FROM dist_emaj.dist_emaj_cluster_group
               JOIN dist_emaj.dist_emaj_server ON (dist_emaj_server.srv_name = dist_emaj_cluster_group.clgrp_server)
          WHERE clgrp_cluster = p_cluster
          GROUP BY srv_name, srv_connect_string
          ORDER BY srv_name
        ) AS servers"
PL/pgSQL function dist_emaj.dist_emaj_verify_cluster(text,boolean) line 41 at PERFORM

delete from dist_emaj.dist_emaj_cluster_group where clgrp_cluster = 'my_cluster' and clgrp_server = 'emaj_1' and clgrp_group like 'extraGroup%';
