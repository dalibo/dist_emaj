--
-- unknown cluster
select dist_emaj.dist_emaj_verify_cluster('dummy');
ERROR:  dist_emaj_verify_cluster: The cluster "dummy" is unknown.
CONTEXT:  PL/pgSQL function dist_emaj.dist_emaj_verify_cluster(text,boolean) line 23 at RAISE
