-- create_drop.sql : non regression tests for Distributed E-Maj objects creation and drop
-- It tests in particular:
--   dist_emaj_create_server(), dist_emaj_drop_server(),
--   dist_emaj_create_cluster(), dist_emaj_drop_cluster(),
--   dist_emaj_assign_group(), dist_emaj_remove_group()
--
-- Prepare the test context
--
-- set sequence restart value
select public.handle_dist_emaj_sequences(1000);
 handle_dist_emaj_sequences 
----------------------------
 
(1 row)

--
-- Test dist_emaj_create_server()
--
-- illegal value
select dist_emaj.dist_emaj_create_server(null, 'a connect string', 2);
ERROR:  dist_emaj_create_server: The server name can't be NULL or empty.
CONTEXT:  PL/pgSQL function dist_emaj.dist_emaj_create_server(text,text,integer,boolean) line 18 at RAISE
select dist_emaj.dist_emaj_create_server('first_server', null, 2);
ERROR:  dist_emaj_create_server: The connect string can't be NULL.
CONTEXT:  PL/pgSQL function dist_emaj.dist_emaj_create_server(text,text,integer,boolean) line 22 at RAISE
select dist_emaj.dist_emaj_create_server('first_server', 'a connect string', null);
ERROR:  dist_emaj_create_server: The number of rollback parallel sessions must be greater than 0.
CONTEXT:  PL/pgSQL function dist_emaj.dist_emaj_create_server(text,text,integer,boolean) line 26 at RAISE
select dist_emaj.dist_emaj_create_server('first_server', 'a connect string', 0);
ERROR:  dist_emaj_create_server: The number of rollback parallel sessions must be greater than 0.
CONTEXT:  PL/pgSQL function dist_emaj.dist_emaj_create_server(text,text,integer,boolean) line 26 at RAISE
-- ok
select dist_emaj.dist_emaj_create_server('first_server', 'a connect string', 2);
