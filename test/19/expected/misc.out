-- Test dist_emaj_verify_all()
-----------------------------
-- add missing groups
select dist_emaj.dist_emaj_assign_group('my_cluster', 'emaj_1', 'extraGroup_1');
 dist_emaj_assign_group 
------------------------
                      1
(1 row)

select dist_emaj.dist_emaj_assign_group('my_cluster', 'emaj_1', 'extraGroup_2');
