-- uninstall.sql : test of the emaj EXTENSION drop
--
-- Try to DROP the dist_emaj schema
drop schema dist_emaj cascade;
NOTICE:  drop cascades to extension dist_emaj
ERROR:  Distributed E-Maj event trigger: Attempting to drop the schema "emaj". Please execute the dist_emaj.dist_emaj_drop_extension() function if you really want to remove all Distributed E-Maj components.
CONTEXT:  PL/pgSQL function _dist_emaj_protection_event_trigger_fnct() line 16 at RAISE
-- Try to DROP EXTENSION
drop extension dist_emaj;
ERROR:  Distributed E-Maj event trigger: Attempting to drop the emaj extension. Please execute the dist_emaj.dist_emaj_drop_extension() function if you really want to remove all Distributed E-Maj components.
CONTEXT:  PL/pgSQL function _dist_emaj_protection_event_trigger_fnct() line 22 at RAISE
-- Call the dist_emaj_drop_extension function
select dist_emaj.dist_emaj_drop_extension();
NOTICE:  drop cascades to event trigger dist_emaj_protection_trg
NOTICE:  dist_emaj_drop_extension: The dist_emaj_adm role has been dropped
NOTICE:  dist_emaj_drop_extension: The dist_emaj_viewer role has been dropped
