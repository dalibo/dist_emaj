-- Errors on a database
--   missing groups (simulated from dist_emaj)
insert into dist_emaj.dist_emaj_cluster_group values
  ('my_cluster', 'emaj_1', 'extraGroup_1'),
  ('my_cluster', 'emaj_1', 'extraGroup_2');
\! ${DIST_EMAJ_DIR}/client/distEmajRollback.pl -d regression -U postgres --cluster my_cluster --mark START
 Distributed E-Maj Rollback (version <devel>)
--------------------------------------------
Error while checking the cluster.
ERROR:  _verify_database (7): Error on database "emaj_1", some table groups (extraGroup_1, extraGroup_2) are missing.
CONTEXT:  PL/pgSQL function dist_emaj._verify_database(text,text,text,text,boolean) line 153 at RAISE
SQL statement "SELECT dist_emaj._verify_database(db_name, db_connect_string, groups_list, v_dblinkSchema, TRUE)
      FROM (
        SELECT db_name, db_connect_string,
               string_agg(quote_literal(clgrp_group), ',' ORDER BY clgrp_group) AS groups_list
          FROM dist_emaj.dist_emaj_cluster_group
               JOIN dist_emaj.dist_emaj_database ON (dist_emaj_database.db_name = dist_emaj_cluster_group.clgrp_database)
          WHERE clgrp_cluster = p_cluster
          GROUP BY db_name, db_connect_string
          ORDER BY db_name
        ) AS databases"
PL/pgSQL function dist_emaj.dist_emaj_verify_cluster(text,boolean) line 38 at PERFORM

delete from dist_emaj.dist_emaj_cluster_group where clgrp_group like 'extraGroup%';
\c regression_1
